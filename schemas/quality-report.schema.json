{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-gate.dev/schemas/quality-report.schema.json",
  "title": "Code Gate Quality Report",
  "type": "object",
  "required": [
    "project",
    "metrics",
    "findings",
    "gates"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "collectors": {
      "description": "How each collector produced its evidence. Absent from reports written before v0.1 recorded it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The collector's [collectors.<name>] key."
          },
          "command": {
            "type": "string",
            "description": "Exact command line run in the project directory."
          },
          "features": {
            "description": "Cargo feature selection, for collectors that build the workspace.",
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "object",
                "required": [
                  "selected"
                ],
                "additionalProperties": false,
                "properties": {
                  "selected": {
                    "type": "object",
                    "required": [
                      "default",
                      "features"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "default": {
                        "type": "boolean"
                      },
                      "features": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "source",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "count",
              "percent",
              "ratio",
              "score",
              "milliseconds",
              "bytes",
              "none"
            ]
          },
          "source": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "message",
          "source",
          "scope"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "column": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array"
    }
  }
}
